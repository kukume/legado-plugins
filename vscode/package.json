{
  "name": "legado",
  "displayName": "Legado",
  "description": "IDE 小说阅读扩展：需要先自行搭建阅读 Web（legado-web）服务端，对接它的开放接口：书架、目录、正文、多端进度同步，以及行内阅读。",
  "version": "1.1.2",
  "publisher": "kukume",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/kukume/legado-plugins.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "legado",
    "reader",
    "novel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Legado",
      "properties": {
        "legado.address": {
          "type": "string",
          "default": "",
          "description": "阅读 Web 的服务器地址，例如 http://192.168.1.10:8080"
        },
        "legado.apiKey": {
          "type": "string",
          "default": "",
          "description": "开放接口的 API Key（在阅读 Web 的“我的 → API Key”中创建，lgd_ 开头）"
        },
        "legado.enableErrorLog": {
          "type": "boolean",
          "default": false,
          "description": "开启异常日志"
        },
        "legado.textBodyFontColor": {
          "type": "string",
          "default": "",
          "description": "正文字体颜色，如 #cccccc；留空则跟随主题"
        },
        "legado.textBodyFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "正文字号（px），0 表示跟随编辑器"
        },
        "legado.inlineReadChunkSize": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 500,
          "description": "行内阅读每页显示的字数"
        },
        "legado.inlineReadStyle": {
          "type": "string",
          "enum": [
            "plain",
            "comment"
          ],
          "enumDescriptions": [
            "普通文字",
            "伪装成代码注释：前面加上当前语言的注释符号，斜体显示"
          ],
          "default": "plain",
          "description": "行内阅读的显示方式"
        },
        "legado.inlineReadColor": {
          "type": "string",
          "default": "",
          "description": "行内阅读的文字颜色，如 #6a9955（与注释颜色一致更隐蔽）；留空则跟随主题"
        },
        "legado.inlineReadHideOnType": {
          "type": "boolean",
          "default": true,
          "description": "编辑代码时自动隐藏行内阅读，下次单击再显示"
        },
        "legado.inlineReadFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "description": "行内阅读字号（px）。0 表示与编辑器字号相同"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "legado",
          "title": "Legado",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "legado": [
        {
          "type": "webview",
          "id": "legado.reader",
          "name": "Legado",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "_legado.refresh",
        "title": "刷新",
        "category": "Legado",
        "icon": {
          "light": "media/icons/refresh.svg",
          "dark": "media/icons/refresh_dark.svg"
        }
      },
      {
        "command": "legado.toggleInlineRead",
        "title": "行内阅读",
        "category": "Legado",
        "icon": {
          "light": "media/icons/inlineRead.svg",
          "dark": "media/icons/inlineRead_dark.svg"
        }
      },
      {
        "command": "legado.inlinePrevChunk",
        "title": "上一段",
        "category": "Legado",
        "icon": {
          "light": "media/icons/previousChapter.svg",
          "dark": "media/icons/previousChapter_dark.svg"
        }
      },
      {
        "command": "legado.inlineNextChunk",
        "title": "下一段",
        "category": "Legado",
        "icon": {
          "light": "media/icons/nextChapter.svg",
          "dark": "media/icons/nextChapter_dark.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "legado.toggleInlineRead",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "_legado.refresh",
          "when": "view == legado.reader",
          "group": "navigation@1"
        },
        {
          "command": "legado.toggleInlineRead",
          "when": "view == legado.reader",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "legado.inlinePrevChunk",
          "when": "editorTextFocus && legado.inlineRead",
          "group": "navigation@1"
        },
        {
          "command": "legado.inlineNextChunk",
          "when": "editorTextFocus && legado.inlineRead",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "_legado.refresh",
          "when": "false"
        },
        {
          "command": "legado.inlinePrevChunk"
        },
        {
          "command": "legado.inlineNextChunk"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.js",
    "package": "npm run compile && npx --yes @vscode/vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  }
}
